[Unit]
Description=Taksichi Brat Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Iftixor/Github/Taksichi_Brat_Bot
ExecStart=/root/Iftixor/Github/Taksichi_Brat_Bot/venv/bin/python bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
